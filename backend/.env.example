PORT=3000
NODE_ENV=development

# PostgreSQL
# 로컬: localhost / 5432 / walkmap / postgres
# Neon(운영): 대시보드 → Connection Details → Pooled connection string 참고
#   host 예시: ep-xxx-pooler.us-east-1.aws.neon.tech
#   클라우드 DB 는 SSL 필수 → DB_SSL=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=walkmap
DB_USER=postgres
DB_PASSWORD=your_password
# 클라우드 DB(Neon/Supabase/Railway) 사용 시 true. 로컬 Postgres 는 비워 두거나 false.
DB_SSL=false
# 서버리스에서 함수 인스턴스마다 커넥션을 새로 만들 수 있으므로 작게 둡니다. 로컬은 10으로 올려도 됩니다.
DB_POOL_MAX=2

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 쿠키 서명 키 (미설정 시 JWT_SECRET 사용)
COOKIE_SECRET=

# ───────────────────────── 사진 업로드 (Vercel Blob) ────────────────────
# 사진은 Vercel Blob 에 저장됩니다. Vercel 대시보드 → Storage → Blob 에서
# 프로젝트에 Blob store 를 연결하면 BLOB_READ_WRITE_TOKEN 이 자동 주입됩니다.
# 로컬에서 실제 업로드를 테스트하거나 마이그레이션 스크립트를 돌릴 때는
# Blob store 의 ".env.local" 토큰을 복사해 여기에 넣으세요.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
MAX_FILE_SIZE=10485760

# 레거시: 로컬 디스크 업로드 폴더 (Blob 이전 전까지만 의미 있음).
# 저장소가 Vercel Blob 으로 전환됐으므로 Vercel 에서는 사용하지 않습니다.
# scripts/migrate-uploads-to-blob.js 가 이 폴더를 읽어 Blob 으로 이전합니다.
UPLOAD_DIR=uploads

# 서비스 지역 (중심: 월계1동 대략 중심)
# 반경(REGION_RADIUS_KM): 코드 기본값은 1.5km(운영·전시용 권장값).
# 운영·전시용 기본값. 테스트로 넓게 보려면 임시로 50 등으로 올려서 사용
REGION_CENTER_LAT=37.6215
REGION_CENTER_LNG=127.0605
REGION_RADIUS_KM=1.5

# CORS: 프론트를 같은 Vercel 프로젝트에서 서빙하면 same-origin 이므로 비워 두면 됩니다.
# 외부 도메인(개발용 로컬 서버, 별도 앱 등)을 허용하려면 쉼표로 구분해 입력:
# CORS_ORIGIN=https://example.com,http://localhost:5173
CORS_ORIGIN=

# 프론트엔드 정적 파일 경로 (로컬 개발 전용, 기본값: ../frontend/web)
# Vercel 에서는 Output Directory 로 설정하므로 이 변수는 무시됩니다.
# FRONTEND_DIR=/var/www/html
FRONTEND_DIR=
# 로컬에서 백엔드가 프론트를 서빙하지 않길 원하면 false 로 설정.
# SERVE_FRONTEND=false

# 제보 승인 시 지급 포인트 (기본값: 10)
POINTS_PER_APPROVAL=10

# 정보 변경 신고가 수락됐을 때 신고자에게 지급하는 포인트 (기본값: 30, 반려 시 지급 없음)
POINTS_PER_CHANGE_REPORT=30

# 요청 제한 (IP당). 미설정 시 괄호 안 기본값 적용.
# 전시처럼 한 IP(공용 와이파이)에서 많은 사람이 접속하면 올려서 사용 (동시 150명 기준 권장값은 아래)
# RATE_LIMIT_API_MAX=10000           # 전체 API, 15분 (기본 100)
# RATE_LIMIT_AUTH_MAX=300            # 로그인·회원가입, 15분 (기본 20)
# RATE_LIMIT_REPORT_MAX=300          # 제보 등록, 1시간 (기본 20)
# RATE_LIMIT_CHANGE_REPORT_MAX=300   # 정보 변경 신고, 1시간 (기본 20)
# RATE_LIMIT_STORE_REDEEM_MAX=300    # 포인트 교환, 1시간 (기본 20)
# RATE_LIMIT_ROUTE_MAX=1000          # 경로 조회(GET /api/route), 1시간 (기본 120)

# 프록시 신뢰 단계 수. 미설정 시 Vercel 에서는 자동으로 1, 로컬은 0.
# 프록시 뒤에서 요청 제한이 방문객 IP별로 동작하게 하는 설정 (프록시가 없는데 켜면 IP 위조 가능)
# TRUST_PROXY=1

# ───────────────────────── TMAP 보행자 길찾기 ─────────────────────────
# GET /api/route(출발/도착 모드)에서 실제 보행로를 계산하기 위해 TMAP 보행자
# 길찾기 API 를 호출합니다. 키가 없으면 /api/route?from_lat=... 호출은
# 503 ROUTING_UNAVAILABLE 로 응답합니다(지도에 경로 선이 그려지지 않음).
# 발급: https://openapi.sk.com → 로그인 → "나의 앱" → 앱 생성 → "appKey" 복사
# TMAP_APP_KEY=여기에_SK오픈API_appKey_입력

# TMAP 요청 타임아웃 (ms, 기본 5000)
# TMAP_TIMEOUT_MS=5000

# 경로 응답 캐시 (TMAP 호출 수 절약).
# 같은 (출발·도착) 좌표 쌍(소수 5자리 반올림)을 TTL 안에서 재사용합니다.
# ROUTE_CACHE_TTL_MS=600000           # TTL (ms, 기본 10분)
# ROUTE_CACHE_SIZE=500                # 최대 엔트리 수 (기본 500)

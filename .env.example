PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=walkmap
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 업로드 (로컬 디스크)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# 서비스 지역 (기본값: 월계1동 대략 중심, 반경 1.5km)
REGION_CENTER_LAT=37.6215
REGION_CENTER_LNG=127.0605
REGION_RADIUS_KM=1.5

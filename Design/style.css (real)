:root {
  --primary: #007EFF;
  --primary-deep: #2230E0;
  --accent: #FFBF00;
  --accent-deep: #735D0B;

  --bg-page: #F0F2F5;
  --bg-surface: #FAFAFA;
  --bg-soft: #F5F5F5;
  --border: #EDEDED;

  --text-main: #1A1A1A;
  --text-sub: #2C2C2C;
  --text-muted: #6B7280;
}

* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
/* 안드로이드 Chrome 등이 글씨가 좁은 화면에 안 맞으면 자동으로 폰트를 키우는 "글꼴 부풀리기"를 끕니다.
   이게 켜져 있으면 같은 CSS인데도 화면·기종마다 글씨 크기가 제각각으로 보일 수 있습니다. */
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body {
  font-family: "Noto Sans KR", sans-serif;
  background: var(--bg-page);
  display: flex; justify-content: center;
}

/* 모바일 폭(390px) 기준 화면 */
#app {
  position: relative; width: 100%; max-width: 390px; height: 100%;
  background: var(--bg-surface); overflow: hidden;
}
#map { position: absolute; inset: 0; }

.topbar {
  position: absolute; top: 12px; left: 12px; right: 12px; z-index: 1000;
  background: var(--bg-surface); border-radius: 18px; padding: 12px 14px 12px 16px;
  box-shadow: 0 6px 20px rgba(34, 48, 224, 0.12);
  font-size: 16px; font-weight: 700; color: var(--text-main);
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.topbar small {
  display: block; font-weight: 400; font-size: 12px; color: var(--text-sub); margin-top: 2px;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

/* 로그인하면 .topbar-user 쪽 버튼이 늘어나 이 영역이 좁아지는데, 줄바꿈 대신 "..."으로 잘라서
   상단바 높이가 늘어나지 않게 합니다 (검색창이 상단바 바로 아래 고정 위치라 높이가 늘면 겹침) */
.topbar-title { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.topbar-user { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; font-size: 13px; font-weight: 600; }
.topbar-user #userName { max-width: 96px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.auth-btn {
  min-height: 44px; padding: 0 14px; border: 1.5px solid var(--primary); border-radius: 22px;
  background: var(--bg-surface); color: var(--primary); font-size: 14px; font-weight: 700; cursor: pointer;
}
.auth-btn:active { background: rgba(0, 126, 255, 0.06); }

/* 프로필 버튼: 로그인하면 마이페이지·닉네임·로그아웃 3개 대신 이 동그란 버튼 하나만 보입니다
   (네이버지도처럼 — 닉네임 첫 글자를 보여주고, 누르면 마이페이지로 이동. 로그아웃은 그 안에 있음) */
.profile-btn {
  width: 40px; height: 40px; flex: 0 0 auto; border-radius: 50%; border: 1.5px solid var(--primary);
  background: var(--primary); color: #FAFAFA; font-size: 19px; font-weight: 800; font-family: inherit;
  display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer;
}
.profile-btn svg { width: 20px; height: 20px; fill: #FAFAFA; }
.profile-btn:active { opacity: .85; }


.legend {
  position: absolute; left: 12px; bottom: 96px; z-index: 1000; max-width: 220px;
  background: var(--bg-surface); border-radius: 10px; padding: 8px 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,.18); font-size: 14px; color: var(--text-sub);
  word-break: keep-all;   /* 한글이 단어 중간에서 줄바꿈되지 않고, 띄어쓰기 단위로만 바뀌게 */
}
.legend[hidden] { display: none; }
.legend-close {
  position: absolute; top: -8px; right: -8px; width: 22px; height: 22px; border: 0;
  background: var(--bg-surface); border-radius: 50%; box-shadow: 0 1px 4px rgba(0,0,0,.25);
  color: var(--text-muted); font-size: 11px; cursor: pointer;
}
.legend-reopen {
  position: absolute; left: 12px; bottom: 96px; z-index: 1000;
  min-height: 40px; padding: 0 14px; border: 2px solid transparent; border-radius: 20px;
  background: var(--bg-surface); color: var(--text-sub); font-size: 13.5px; font-weight: 700;
  box-shadow: 0 2px 8px rgba(0,0,0,.18); cursor: pointer;
}
.legend-reopen:active { border-color: var(--primary); }
.legend-reopen[hidden] { display: none; }
.legend div { display: flex; align-items: center; gap: 8px; line-height: 1.8; }
.legend-stat {
  font-size: 12px; font-weight: 700; color: var(--primary); margin-bottom: 4px;
  padding-bottom: 6px; border-bottom: 1px solid var(--border);
}
.legend-stat[hidden] { display: none; }
.legend i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid #FAFAFA; box-shadow: 0 0 0 1px rgba(0,0,0,.25); }

/* 서비스 소개(온보딩)의 아이콘 안내 + 두 가지 시작 버튼 */
.onboard-legend {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px 12px; margin: 10px 0 4px;
  font-size: 14px; color: var(--text-sub);
}
.onboard-legend div { display: flex; align-items: center; gap: 8px; }
.onboard-legend i {
  width: 14px; height: 14px; border-radius: 50%; flex: 0 0 auto;
  border: 2px solid #FAFAFA; box-shadow: 0 0 0 1px rgba(0,0,0,.25);
}
.onboard-actions { display: flex; gap: 10px; margin-top: 18px; }
.onboard-action-btn {
  flex: 1; min-height: 76px; padding: 10px; border: 2px solid var(--primary); border-radius: 14px;
  background: var(--bg-surface); color: var(--primary); font-family: inherit; font-weight: 700; font-size: 14.5px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; cursor: pointer;
}
.onboard-action-btn .icon { font-size: 24px; }
.onboard-action-btn:active { background: rgba(0, 126, 255, 0.08); }

/* 지도 오른쪽 아래 버튼들: 평소엔 테두리가 안 보이다가, 누르고 있는 동안만 파란 테두리가 보이게 합니다.
   ("테두리가 항상 둘려 있어서 눌러야만 생기면 좋겠다"는 피드백, 2026-10-08 — 늘 선택된 것처럼 보여 헷갈림) */
.locate-btn {
  position: absolute; right: 12px; bottom: 96px; z-index: 1000;
  min-height: 48px; padding: 0 16px; border: 2px solid transparent; border-radius: 24px;
  background: var(--bg-surface); color: var(--primary); font-size: 15px; font-weight: 700;
  box-shadow: 0 4px 14px rgba(34, 48, 224, 0.14); cursor: pointer;
}
.locate-btn:active { border-color: var(--primary); }



.filter-btn {
  position: absolute; right: 12px; bottom: 152px; z-index: 1000;
  min-height: 48px; padding: 0 18px; border: 2px solid transparent; border-radius: 24px;
  background: var(--bg-surface); color: var(--primary); font-size: 15px; font-weight: 700;
  box-shadow: 0 4px 14px rgba(34, 48, 224, 0.14); cursor: pointer;
}
.filter-btn:active { border-color: var(--primary); }
.filter-btn.active { background: var(--primary); color: #FAFAFA; }   /* 조건이 걸려 있으면 눈에 띄게 (누름 상태와 다른, 계속 켜 있는 표시) */



/* 경로 찾기: 2026-10-08, 오른쪽이 버튼으로 지저분해 보인다는 피드백으로 지도 앱들처럼
   검색창 옆 작은 아이콘 버튼으로 옮김 (.search-row 안에서 씀, 위치는 거기서 정해짐) */
.route-btn {
  flex: 0 0 auto; width: 50px; height: 50px; border: 2px solid transparent; border-radius: 16px;
  background: var(--bg-surface); color: var(--primary); font-size: 22px;
  box-shadow: 0 4px 16px rgba(34, 48, 224, 0.10); cursor: pointer;
}
.route-btn:active { border-color: var(--primary); }

.text-size-btn {
  position: absolute; right: 12px; bottom: 208px; z-index: 1000;
  min-height: 48px; padding: 0 16px; border: 2px solid transparent; border-radius: 24px;
  background: var(--bg-surface); color: var(--primary); font-size: 15px; font-weight: 700;
  box-shadow: 0 4px 14px rgba(34, 48, 224, 0.14); cursor: pointer;
}
.text-size-btn:active { border-color: var(--primary); }
.text-size-btn.active { background: var(--primary); color: #FAFAFA; }   /* 글씨 크게가 켜져 있으면 눈에 띄게 */


.route-clear-btn {
  position: absolute; left: 50%; transform: translateX(-50%); top: var(--below-search, 140px); z-index: 1000;
  min-height: 40px; padding: 0 16px; border: 0; border-radius: 20px;
  background: rgba(31,45,61,.92); color: #FAFAFA; font-size: 13.5px; font-weight: 700; cursor: pointer;
}
.route-clear-btn[hidden] { display: none; }

/* 경로 찾기 창: 출발/도착 지점 */
.route-point {
  border: 1.5px solid;border-color: var(--border); border-radius: 12px; padding: 10px 12px; margin-bottom: 4px;
}
.route-point.set { border-color: var(--primary); background: rgba(0, 126, 255, 0.06); }
.route-point-text { font-size: 14.5px; color: var(--text-main); margin-bottom: 8px; word-break: break-word; }
.route-point.set .route-point-text { color: var(--primary-deep); font-weight: 700; }
.route-point-actions { display: flex; gap: 8px; }
.route-point-actions .check-btn { flex: 1; min-height: 44px; }

/* 경로 찾기 결과 */
.route-summary { font-size: 13.5px; color: var(--text-muted); margin: 4px 0 10px; }
.route-summary[hidden] { display: none; }
.route-warning {
  display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
  padding: 10px 0; border-bottom: 1px solid var(--border);
}
.route-warning:last-of-type { border-bottom: none; }
.route-warning-title { flex: 1 0 100%; font-size: 14px; font-weight: 700; color: var(--text-main); }
.route-warning-dist { flex: 1 0 100%; font-size: 12.5px; color: var(--text-muted); }
.route-ok { padding: 10px 0; font-size: 14px; color: #17603a; }
.route-more { padding: 8px 0 0; font-size: 12.5px; color: var(--text-muted); }

/* 지도 위 경로 표시 */
.route-dot { width: 18px; height: 18px; border-radius: 50%; border: 3px solid #FAFAFA; box-shadow: 0 1px 6px rgba(0,0,0,.45); }
.route-dot-start { background: #2e9e5b; }
.route-dot-end { background: #d32f2f; }

.report-btn {
  position: absolute; left: 16px; right: 16px; bottom: 24px; z-index: 1000;
  height: 52px; border: 0; border-radius: 26px;
  background: var(--primary); color: #FAFAFA; font-size: 17px; font-weight: 700;
  box-shadow: 0 6px 18px rgba(0, 126, 255, 0.28); cursor: pointer;
}
.report-btn:active { background: var(--primary-deep); }



.toast {
  position: absolute; top: 138px; left: 16px; right: 16px; z-index: 1100;
  background: rgba(31,45,61,.92); color: #FAFAFA; border-radius: 10px;
  padding: 12px 14px; font-size: 15px; line-height: 1.45; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.toast-btn {
  min-height: 44px; padding: 0 20px; border: 0; border-radius: 22px;
  background: var(--bg-surface); color: var(--text-main); font-size: 15px; font-weight: 700; cursor: pointer;
}
.toast-btn:active { background: #dfe6ee; }

.leaflet-top.leaflet-right { top: var(--below-search, 150px); }   /* 상단 바와 검색란(+경로 버튼) 아래로, js/layout.js가 실제 높이에 맞춰 계산함 */

/* ===== 제보 위치 직접 선택 ===== */
.pick-open {
  display: block; width: 100%; min-height: 52px; margin-top: 8px; border: 2px solid; border-color: var(--primary); border-radius: 12px;
  background: var(--bg-surface); color: var(--primary); font-size: 16px; font-weight: 700; font-family: inherit; cursor: pointer;
}
.pick-open:active { background: rgba(0, 126, 255, 0.08); }


.pick-overlay { position: absolute; inset: 0; z-index: 2500; background: var(--bg-surface); }
.pick-overlay[hidden] { display: none; }
#pickMap { position: absolute; inset: 0; }
#pickSheet .leaflet-top.leaflet-right { top: 130px; }   /* 위쪽 바와 장소 검색란 아래로 */
.pick-search { position: absolute; top: 68px; left: 12px; right: 12px; z-index: 1300; }
.pick-top {
  position: absolute; top: 0; left: 0; right: 0; z-index: 1300;
  display: flex; align-items: center; gap: 8px; padding: 8px 12px;
  background: var(--bg-surface); box-shadow: 0 2px 8px rgba(0,0,0,.15);
}
.pick-back {
  min-height: 44px; padding: 0 14px; border: 0; border-radius: 22px; background: var(--bg-soft);
  color: var(--text-main); font-size: 15px; font-weight: 700; font-family: inherit; cursor: pointer;
}
.pick-title { font-size: 17px; font-weight: 700; color: var(--text-main); }
/* 핀은 화면 가운데에 고정: 뾰족한 끝이 정확히 가운데를 가리킵니다 */
.pick-pin { position: absolute; left: 50%; top: 50%; width: 0; height: 0; z-index: 1200; pointer-events: none; }
.pick-pin::before {
  content: ''; position: absolute; left: -15px; top: -36px; width: 30px; height: 30px;
  border-radius: 50% 50% 50% 0; background: #d32f2f; border: 3px solid #FAFAFA;
  transform: rotate(-45deg); box-shadow: 0 2px 6px rgba(0,0,0,.4);
}
.pick-pin::after {
  content: ''; position: absolute; left: -4px; top: -4px; width: 8px; height: 8px;
  border-radius: 50%; background: rgba(0,0,0,.35);
}
#pickSheet .locate-btn { bottom: 150px; z-index: 1300; }
.pick-bottom {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 1300;
  padding: 12px 16px 20px; background: var(--bg-surface); border-radius: 16px 16px 0 0;
  box-shadow: 0 -2px 10px rgba(0,0,0,.2);
}
.pick-hint { font-size: 14px; color: var(--text-sub); line-height: 1.45; }
.pick-bottom .primary { margin-top: 10px; }

/* ===== 검색란 ===== */

.search-wrap {
  position: absolute;
  top: 82px;
  left: 12px;
  right: 12px;
  z-index: 1000;
}
.search-row { display: flex; align-items: center; gap: 8px; }
.search-form { position: relative; flex: 1; min-width: 0; }
.search-form input, .pick-search input {
  width: 100%; min-height: 50px; padding: 0 46px 0 18px; border: 0; border-radius: 16px;
  background: var(--bg-surface); box-shadow: 0 4px 16px rgba(34, 48, 224, 0.10);
  font-size: 16px; font-family: inherit; color: var(--text-main);
}
.search-form input:focus, .pick-search input:focus { outline: none; box-shadow:
    0 0 0 3px rgba(0, 126, 255, 0.22),
    0 4px 14px rgba(34, 48, 224, 0.08); }
.search-clear {
  position: absolute; right: 2px; top: 2px; width: 44px; height: 44px; border: 0;
  background: none; color: var(--text-muted); font-size: 16px; cursor: pointer;
}
.search-results {
  margin-top: 6px; background: var(--bg-surface); border-radius: 14px; box-shadow: 0 4px 14px rgba(0,0,0,.25);
  max-height: 50vh; overflow-y: auto; padding: 6px 0;
}
.search-heading { padding: 8px 16px 4px; font-size: 12px; font-weight: 700; color: var(--text-muted); }
.search-item {
  display: block; width: 100%; min-height: 48px; padding: 10px 16px; border: 0; background: none;
  text-align: left; font-family: inherit; cursor: pointer;
}
.search-item:hover, .search-item:active { background: rgba(0, 126, 255, 0.06); }
.search-item-title { font-size: 15px; font-weight: 700; color: var(--text-main); }
.search-item-sub { font-size: 13px; color: var(--text-muted); margin-top: 2px; word-break: break-word; }
.search-item.place { border-top: 1px solid var(--border); color: var(--primary); font-size: 15px; font-weight: 700; }
.search-note { padding: 10px 16px; font-size: 14px; color: var(--text-muted); line-height: 1.45; }
.search-note.err { color: #c62828; }
.search-pin { width: 24px; height: 24px; border-radius: 50%; background: #d32f2f; border: 3px solid #FAFAFA; box-shadow: 0 1px 6px rgba(0,0,0,.45); }

/* ===== 로그인·회원가입 시트 ===== */
.sheet-backdrop {
  position: absolute; inset: 0; z-index: 2000;
  background: rgba(20,30,45,.5);
  display: flex; align-items: flex-end;
}
.sheet-backdrop[hidden] { display: none; }
.sheet {
  position: relative; width: 100%; max-height: 92%; overflow-y: auto;
  background: var(--bg-surface); border-radius: 20px 20px 0 0;
  padding: 20px 20px 28px; color: var(--text-main);
}
.sheet-close {
  position: absolute; top: 8px; right: 8px; width: 44px; height: 44px;
  border: 0; background: none; font-size: 20px; color: var(--text-muted); cursor: pointer;
}
.tabs { display: flex; gap: 8px; margin: 0 40px 12px 0; }
.tab {
  flex: 1; min-height: 48px; border: 0; border-radius: 12px;
  background: var(--bg-soft); color: var(--text-muted); font-size: 17px; font-weight: 700; cursor: pointer;
}
.tab.active { background: var(--primary); color: #FAFAFA; }


.sheet-note { margin: 0 0 8px; font-size: 14px; color: var(--primary-deep); min-height: 0; }
.sheet-note:empty { display: none; }
.sheet-note.small { margin: 12px 0 0; font-size: 13px; color: var(--text-muted); }

.sheet label { display: block; margin: 14px 0 6px; font-size: 15px; font-weight: 700; }
.sheet .hint { font-weight: 400; font-size: 12px; color: var(--text-muted); }
.sheet input {
  width: 100%; min-height: 52px; padding: 0 14px;
  border: 1.5px solid; border-color: var(--border); border-radius: 12px;
  font-size: 17px; font-family: inherit; color: var(--text-main); background: var(--bg-surface);
}

.sheet input:focus { outline: none; border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(0, 126, 255, 0.18); }
.sheet .row { display: flex; gap: 8px; }
.sheet .row input { flex: 1; min-width: 0; }
.check-btn {
  flex: 0 0 auto; min-height: 52px; padding: 0 12px; border: 1.5px solid; border-color: var(--primary);
  border-radius: 12px; background: var(--bg-surface); color: var(--primary); font-size: 15px; font-weight: 700; cursor: pointer;
}
.check-btn:active { background: rgba(0, 126, 255, 0.08); }


.field-msg { min-height: 20px; margin-top: 6px; font-size: 14px; line-height: 1.4; }
.field-msg:empty { min-height: 0; margin: 0; }
.field-msg.err { color: #c62828; }
.field-msg.ok { color: #1b7f43; }
.primary {
  width: 100%; min-height: 54px; margin-top: 16px; border: 0; border-radius: 27px;
  background: var(--primary); color: #FAFAFA; font-size: 18px; font-weight: 700; cursor: pointer;
}
.primary:active { background: var(--primary-deep); }

button:disabled { opacity: .6; cursor: default; }

/* ===== 제보 등록 창 ===== */
.sheet.report, .sheet.sheet-flush { padding-bottom: 0; }
.sheet-title { margin: 0 40px 4px 0; font-size: 22px; }

/* 마이페이지: 닉네임 + 로그아웃 (상단바 프로필 버튼을 누르면 들어오는 화면) */
.mypage-nickname { margin: 0 0 4px; font-size: 15px; color: var(--text-sub); font-weight: 700; }
.mypage-logout {
  margin: 0 0 8px; padding: 2px 0; border: 0; background: none; color: var(--text-muted);
  font-size: 13px; font-weight: 700; text-decoration: underline; font-family: inherit; cursor: pointer;
}

/* 포인트 내역: 최근 N개월만 보이다가 눌러서 전체 보기 */
.point-range-toggle {
  display: block; width: 100%; margin: 4px 0 2px; padding: 10px 0; border: 0; border-top: 1px solid var(--border);
  background: none; color: var(--primary); font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer;
}
.point-range-toggle[hidden] { display: none; }
.section-title { margin: 20px 0 8px; font-size: 16px; font-weight: 700; }
.section-title .hint { font-weight: 400; font-size: 12px; color: var(--text-muted); }

.photo-grid { display: flex; gap: 8px; flex-wrap: wrap; }
.photo-grid:empty { display: none; }
.photo-item {
  position: relative; width: 96px; height: 96px; border-radius: 12px;
  background: var(--bg-soft); overflow: hidden; display: flex; align-items: center; justify-content: center;
}
.photo-item img { width: 100%; height: 100%; object-fit: cover; }
.photo-fallback { font-size: 12px; color: var(--text-muted); text-align: center; padding: 4px; }
.photo-del {
  position: absolute; top: 2px; right: 2px; width: 32px; height: 32px; border: 0;
  border-radius: 50%; background: rgba(0,0,0,.6); color: #FAFAFA; font-size: 14px; cursor: pointer;
}
.photo-add {

{
  "version": 2,
  "installCommand": "npm install && npm install --prefix backend",
  "outputDirectory": "frontend/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__rewritePath=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  }
}
